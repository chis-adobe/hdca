{
  "groups": [
    {
      "title": "Default Content",
      "id": "default",
      "components": [
        {
          "title": "Text",
          "id": "text",
          "plugins": {
            "da": {
              "name": "text",
              "type": "text"
            }
          }
        },
        {
          "title": "Image",
          "id": "image",
          "model": "image",
          "plugins": {
            "da": {
              "name": "image",
              "type": "image",
              "fields": [
                {
                  "name": "image",
                  "selector": "img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "img[alt]"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "title": "Sections",
      "id": "sections",
      "components": [
        {
          "title": "Section",
          "id": "section",
          "plugins": {
            "da": {
              "unsafeHTML": "<div></div>"
            }
          },
          "filter": "section",
          "model": "section"
        }
      ]
    },
    {
      "title": "Blocks",
      "id": "blocks",
      "components": [
        {
          "title": "Accordion",
          "id": "accordion",
          "model": "accordion",
          "filter": "accordion",
          "plugins": {
            "da": {
              "name": "accordion",
              "rows": 0,
              "columns": 0
            }
          }
        },
        {
          "title": "Accordion Item",
          "id": "accordion-item",
          "model": "accordion-item",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2,
              "fields": [
                {
                  "name": "summary",
                  "selector": "div:nth-child(1)"
                },
                {
                  "name": "text",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Card Carousel",
          "id": "card-carousel",
          "plugins": {
            "da": {
              "rows": 0,
              "columns": 0
            }
          },
          "model": "card-carousel",
          "filter": "card-carousel"
        },
        {
          "title": "Card",
          "id": "card",
          "model": "card",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2,
              "fields": [
                {
                  "name": "image",
                  "selector": "div:nth-child(1)>picture>img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "div:nth-child(1)>picture>img[alt]"
                },
                {
                  "name": "text",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Cards",
          "id": "cards",
          "plugins": {
            "da": {
              "rows": 0,
              "columns": 0
            }
          },
          "model": "cards",
          "filter": "cards"
        },
        {
          "title": "Carousel",
          "id": "carousel",
          "model": "carousel",
          "plugins": {
            "da": {
              "rows": 0,
              "columns": 0
            }
          }
        },
        {
          "title": "Carousel Slide",
          "id": "carousel-item",
          "model": "carousel-item",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 2,
              "fields": [
                {
                  "name": "backgroundImage",
                  "selector": "div:nth-child(1)>picture>img[src]"
                },
                {
                  "name": "backgroundImageAlt",
                  "selector": "div:nth-child(1)>picture>img[alt]"
                },
                {
                  "name": "content",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Columns",
          "id": "columns",
          "model": "columns",
          "filter": "columns",
          "plugins": {
            "da": {
              "name": "columns",
              "rows": 1,
              "columns": 2,
              "behaviour": "columns"
            }
          }
        },
        {
          "title": "Columns Row",
          "id": "columns-row",
          "model": "columns-row",
          "filter": "columns-row",
          "plugins": {
            "da": {
              "name": "columns-row",
              "behaviour": "columns-row"
            }
          }
        },
        {
          "title": "Columns Cell",
          "id": "columns-cell",
          "model": "columns-cell",
          "filter": "columns-cell",
          "plugins": {
            "da": {
              "unsafeHTML": "<div></div>",
              "behaviour": "columns-cell"
            }
          }
        },
        {
          "title": "Fragment",
          "id": "fragment",
          "model": "fragment",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"fragment\"><div><div><p><a href=\"\">Fragment URL</a></p></div></div></div>",
              "fields": [
                {
                  "name": "url",
                  "selector": "div>div>p>a[href]"
                },
                {
                  "name": "urlText",
                  "selector": "div>div>p>a"
                }
              ]
            }
          }
        },
        {
          "title": "Hero",
          "id": "hero",
          "model": "hero",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"hero\"><div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture></div><div>background-image</div></div><div><div><h2></h2></div><div></div></div><div><div><a href=\"#\"></a></div><div>primary</div></div></div>",
              "fields": [
                {
                  "name": "image",
                  "selector": "div:nth-child(1)>div:nth-child(1) picture > img[src]"
                },
                {
                  "name": "imageAlt",
                  "selector": "div:nth-child(1)>div:nth-child(1) picture > img[alt]"
                },
                {
                  "name": "imageStyle",
                  "selector": "div:nth-child(1)>div:nth-child(2)"
                },
                {
                  "name": "text",
                  "selector": "div:nth-child(2)>div:nth-child(1)"
                },
                {
                  "name": "textStyle",
                  "selector": "div:nth-child(2)>div:nth-child(2)"
                },
                {
                  "name": "cta",
                  "selector": "div:nth-child(3)>div:nth-child(1)>a[href]"
                },
                {
                  "name": "ctaStyle",
                  "selector": "div:nth-child(3)>div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Quote",
          "id": "quote",
          "model": "quote",
          "plugins": {
            "da": {
              "rows": 2,
              "columns": 1,
              "fields": [
                {
                  "name": "quote",
                  "selector": "div:nth-child(1)>div"
                },
                {
                  "name": "author",
                  "selector": "div:nth-child(2)>div"
                }
              ]
            }
          }
        },
        {
          "title": "Search",
          "id": "search",
          "model": "search",
          "plugins": {
            "da": {
              "rows": 1,
              "columns": 1,
              "fields": [
                {
                  "name": "searchUrl",
                  "selector": "div>div>p>a[href]"
                },
                {
                  "name": "searchUrlText",
                  "selector": "div>div>p>a"
                }
              ]
            }
          }
        },
        {
          "title": "Section Title",
          "id": "section-title",
          "model": "section-title",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"section-title\"><div><div></div></div><div><div></div></div><div><div></div></div><div><div></div></div><div><div></div></div><div><div></div></div><div><div></div></div><div><div></div></div></div>",
              "rows": 8,
              "columns": 1,
              "fields": [
                {
                  "name": "title",
                  "selector": "div:nth-child(1)>div"
                },
                {
                  "name": "titleType",
                  "selector": "div:nth-child(2)>div"
                },
                {
                  "name": "title-size",
                  "selector": "div:nth-child(3)>div"
                },
                {
                  "name": "alignment",
                  "selector": "div:nth-child(4)>div"
                },
                {
                  "name": "classes",
                  "selector": "div:nth-child(5)>div"
                },
                {
                  "name": "subtitle",
                  "selector": "div:nth-child(6)>div"
                },
                {
                  "name": "subtitleType",
                  "selector": "div:nth-child(7)>div"
                },
                {
                  "name": "subtitle-size",
                  "selector": "div:nth-child(8)>div"
                }
              ]
            }
          }
        },
        {
          "title": "Table",
          "id": "table",
          "model": "table",
          "filter": "table",
          "plugins": {
            "da": {
              "name": "table",
              "rows": 1,
              "columns": 1,
              "fields": [
                {
                  "name": "table",
                  "selector": "div>div"
                }
              ]
            }
          }
        },
        {
          "title": "Tabs",
          "id": "tabs",
          "model": "tabs",
          "filter": "tabs",
          "plugins": {
            "da": {
              "columns": 0,
              "rows": 0
            }
          }
        },
        {
          "title": "Tabs Item",
          "id": "tabs-item",
          "model": "tabs-item",
          "plugins": {
            "da": {
              "columns": 2,
              "rows": 1,
              "fields": [
                {
                  "name": "name",
                  "selector": "div:nth-child(1)"
                },
                {
                  "name": "content",
                  "selector": "div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Video",
          "id": "video",
          "model": "video",
          "plugins": {
            "da": {
              "name": "video",
              "rows": 1,
              "columns": 1,
              "fields": [
                {
                  "name": "videoUrl",
                  "selector": "div>div>p>a[href]"
                },
                {
                  "name": "videoUrlText",
                  "selector": "div>div>p>a"
                },
                {
                  "name": "posterImage",
                  "selector": "div>div>picture>img[src]"
                }
              ]
            }
          }
        },
        {
          "title": "Product Details",
          "id": "product-details",
          "model": "product-details",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"product-details\"><div><div>Primary Images</div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture></div></div><div><div>Product Name</div><div></div></div><div><div>Brand</div><div></div></div><div><div>Price</div><div></div></div><div><div>Short Description</div><div></div></div><div><div>Key Features</div><div></div></div><div><div>SKU</div><div></div></div><div><div>Model Number</div><div></div></div><div><div>Breadcrumb Category</div><div></div></div><div><div>Colour Family</div><div></div></div><div><div>Assembled Depth (in)</div><div></div></div><div><div>Assembled Height (in)</div><div></div></div><div><div>Assembled Width (in)</div><div></div></div><div><div>Assembled Weight (lbs)</div><div></div></div><div><div>Packaged Depth (in)</div><div></div></div><div><div>Packaged Height (in)</div><div></div></div><div><div>Packaged Width (in)</div><div></div></div><div><div>Packaged Weight (lbs)</div><div></div></div><div><div>Review Count</div><div></div></div><div><div>Warranty</div><div></div></div><div><div>Source URL</div><div></div></div></div>",
              "fields": [
                {
                  "name": "primaryImage",
                  "selector": "div:nth-child(1)>div:nth-child(2) picture > img[src]"
                },
                {
                  "name": "primaryImageAlt",
                  "selector": "div:nth-child(1)>div:nth-child(2) picture > img[alt]"
                },
                {
                  "name": "productName",
                  "selector": "div:nth-child(2)>div:nth-child(2)"
                },
                {
                  "name": "brand",
                  "selector": "div:nth-child(3)>div:nth-child(2)"
                },
                {
                  "name": "price",
                  "selector": "div:nth-child(4)>div:nth-child(2)"
                },
                {
                  "name": "shortDescription",
                  "selector": "div:nth-child(5)>div:nth-child(2)"
                },
                {
                  "name": "keyFeatures",
                  "selector": "div:nth-child(6)>div:nth-child(2)"
                },
                {
                  "name": "sku",
                  "selector": "div:nth-child(7)>div:nth-child(2)"
                },
                {
                  "name": "modelNumber",
                  "selector": "div:nth-child(8)>div:nth-child(2)"
                },
                {
                  "name": "breadcrumbCategory",
                  "selector": "div:nth-child(9)>div:nth-child(2)"
                },
                {
                  "name": "colourFamily",
                  "selector": "div:nth-child(10)>div:nth-child(2)"
                },
                {
                  "name": "assembledDepthIn",
                  "selector": "div:nth-child(11)>div:nth-child(2)"
                },
                {
                  "name": "assembledHeightIn",
                  "selector": "div:nth-child(12)>div:nth-child(2)"
                },
                {
                  "name": "assembledWidthIn",
                  "selector": "div:nth-child(13)>div:nth-child(2)"
                },
                {
                  "name": "assembledWeightLbs",
                  "selector": "div:nth-child(14)>div:nth-child(2)"
                },
                {
                  "name": "packagedDepthIn",
                  "selector": "div:nth-child(15)>div:nth-child(2)"
                },
                {
                  "name": "packagedHeightIn",
                  "selector": "div:nth-child(16)>div:nth-child(2)"
                },
                {
                  "name": "packagedWidthIn",
                  "selector": "div:nth-child(17)>div:nth-child(2)"
                },
                {
                  "name": "packagedWeightLbs",
                  "selector": "div:nth-child(18)>div:nth-child(2)"
                },
                {
                  "name": "reviewCount",
                  "selector": "div:nth-child(19)>div:nth-child(2)"
                },
                {
                  "name": "warrantyText",
                  "selector": "div:nth-child(20)>div:nth-child(2)"
                },
                {
                  "name": "sourceUrl",
                  "selector": "div:nth-child(21)>div:nth-child(2)>a[href]"
                }
              ]
            }
          }
        },
        {
          "title": "Product Carousel",
          "id": "product-carousel",
          "model": "product-carousel",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"product-carousel\"><div><div>Background Image</div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture></div></div><div><div>Thumbnail</div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture></div></div><div><div>Heading</div><div></div></div><div><div>Description</div><div></div></div><div><div>CTA</div><div></div></div><div><div>Products</div><div></div></div></div>",
              "fields": [
                {
                  "name": "backgroundImage",
                  "selector": "div:nth-child(1)>div:nth-child(2) picture > img[src]"
                },
                {
                  "name": "backgroundImageAlt",
                  "selector": "div:nth-child(1)>div:nth-child(2) picture > img[alt]"
                },
                {
                  "name": "thumbnail",
                  "selector": "div:nth-child(2)>div:nth-child(2) picture > img[src]"
                },
                {
                  "name": "thumbnailAlt",
                  "selector": "div:nth-child(2)>div:nth-child(2) picture > img[alt]"
                },
                {
                  "name": "heading",
                  "selector": "div:nth-child(3)>div:nth-child(2)"
                },
                {
                  "name": "description",
                  "selector": "div:nth-child(4)>div:nth-child(2)"
                },
                {
                  "name": "cta",
                  "selector": "div:nth-child(5)>div:nth-child(2)"
                },
                {
                  "name": "products",
                  "selector": "div:nth-child(6)>div:nth-child(2)"
                }
              ]
            }
          }
        },
        {
          "title": "Popular Searches",
          "id": "popular-searches",
          "model": "popular-searches",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"popular-searches\"><div><div><h2>Popular Searches</h2><ul><li><a href=\"#\">Search term</a></li></ul></div></div></div>",
              "fields": [
                {
                  "name": "content",
                  "selector": "div>div"
                }
              ]
            }
          }
        },
        {
          "title": "Flyer Offers",
          "id": "flyer-offers",
          "model": "flyer-offers",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"flyer-offers\"><div><div>Check Out These Top Flyer Offers</div></div><div><div><ul><li><a href=\"/fragments/products/\">Product</a></li></ul></div></div></div>",
              "fields": [
                {
                  "name": "title",
                  "selector": "div:nth-child(1)>div"
                },
                {
                  "name": "products",
                  "selector": "div:nth-child(2)>div"
                }
              ]
            }
          }
        },
        {
          "title": "Shop by Department",
          "id": "shop-by-department",
          "model": "shop-by-department",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"shop-by-department\"><div><div><h2>Shop by Department</h2><ul><li><a href=\"/dept/\">Department</a></li></ul></div></div></div>",
              "fields": [
                {
                  "name": "content",
                  "selector": "div>div"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
