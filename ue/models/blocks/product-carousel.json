{
  "definitions": [
    {
      "title": "Product Carousel",
      "id": "product-carousel",
      "model": "product-carousel",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"product-carousel\"><div><div>Background Image</div><div><img loading=\"lazy\"></div></div><div><div>Thumbnail</div><div><img loading=\"lazy\"></div></div><div><div>Heading</div><div></div></div><div><div>Description</div><div></div></div><div><div>CTA</div><div></div></div><div><div>Products</div><div></div></div></div>",
          "fields": [
            { "name": "backgroundImage", "selector": "div:nth-child(1)>div:nth-child(2) img[src]" },
            { "name": "backgroundImageAlt", "selector": "div:nth-child(1)>div:nth-child(2) img[alt]" },
            { "name": "thumbnail", "selector": "div:nth-child(2)>div:nth-child(2) img[src]" },
            { "name": "thumbnailAlt", "selector": "div:nth-child(2)>div:nth-child(2) img[alt]" },
            { "name": "heading", "selector": "div:nth-child(3)>div:nth-child(2)" },
            { "name": "description", "selector": "div:nth-child(4)>div:nth-child(2)" },
            { "name": "cta", "selector": "div:nth-child(5)>div:nth-child(2)" },
            { "name": "products", "selector": "div:nth-child(6)>div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "product-carousel",
      "fields": [
        { "component": "reference", "valueType": "string", "name": "backgroundImage", "label": "Background Image", "multi": false },
        { "component": "text", "valueType": "string", "name": "backgroundImageAlt", "label": "Background Image Alt", "value": "" },
        { "component": "reference", "valueType": "string", "name": "thumbnail", "label": "Thumbnail", "multi": false },
        { "component": "text", "valueType": "string", "name": "thumbnailAlt", "label": "Thumbnail Alt", "value": "" },
        { "component": "text", "valueType": "string", "name": "heading", "label": "Heading", "value": "" },
        { "component": "text", "valueType": "string", "name": "description", "label": "Description", "value": "" },
        { "component": "richtext", "valueType": "string", "name": "cta", "label": "CTA", "value": "" },
        { "component": "richtext", "valueType": "string", "name": "products", "label": "Products (links to /fragments/products/{sku})", "value": "" }
      ]
    }
  ],
  "filters": []
}
